nextflow.enable.dsl = 2

manifest {
    name            = 'Katana-PRISM'
    author          = 'Dhruba Tara Maharjan'
    contributors    = [
        [
            name: 'Dhruba Tara Maharjan',
            affiliation: 'Department of Medical Biochemistry and Biophysics, Karolinska Institutet',
            email: 'dhruba.tara.maharjan@ki.se',
            github: '@Taratype0',
            contribution: ['author', 'maintainer']
        ],
        [
            name: 'Onur Dagliyan',
            affiliation: 'Department of Medical Biochemistry and Biophysics, Karolinska Institutet',
            email: 'onur.dagliyan@ki.se',
            contribution: ['author']
        ]
    ]
    description     = 'End-to-end RNA splicing, isoform usage, co-splicing network (SpliceNet), and cis-regulatory RBP consequence (SpliceTrace) pipeline'
    homePage        = 'https://github.com/Taratype0/Katana-PRISM'
    version         = '1.0.3'
    nextflowVersion = '!>=24.04.0'
}

params {
    // Execution & storage modes
    mode                    = 'complete'      // complete | upstream-only | downstream-only | single-cell | targets
    output_layout           = 'standard'
    storage_mode            = 'retain'        // retain | lean
    publish_dir_mode        = 'copy'
    clean_work              = false
    outdir                  = 'results'
    help                    = false

    // Selected-target GeneCard / EventCard follow-up (`-entry TARGETS` or `--mode targets`)
    target_request          = null
    target_bindings         = null
    targets_tsv             = null
    bams_dir                = null

    // Core study inputs
    input                   = null
    contrasts               = null
    fasta                   = null
    gtf                     = null
    bundle                  = null
    sc_events               = null
    sc_psi                  = null
    sc_support              = null
    sc_metadata             = null
    sc_event_genes          = null
    sc_expression           = null
    sc_numerator            = null
    sc_denominator          = null
    sc_contrasts            = null
    sc_celltype_cols        = null
    sc_condition_pairs      = null
    sc_min_donors_per_arm   = 2
    sc_fastq_manifest       = null
    sc_10x_fastq_sheet      = null
    sc_sj_dir               = null
    sc_bam                  = null
    sc_barcode_shares       = null
    sc_umi_matrix           = null
    sc_gene_names           = null
    sc_bc_tag               = 'BC'
    sc_quantifier           = 'marvel'        // marvel (Wen et al., NAR 2023) | sj-direct
    marvel_tarball          = null
    sc_cb_whitelist         = null
    sc_cb_len               = 16
    sc_umi_len              = 12
    sc_group_col            = 'condition'
    sc_min_cells            = 15
    sc_min_cell_support     = 3.0
    sc_pseudobulk_by        = null
    study_name              = 'Katana study'
    species                 = 'mouse'
    genome                  = null
    reference_build         = 'GRCm39'
    annotation_release      = null
    design                  = '~ condition'
    design_factors          = ['condition']
    analysis_purpose        = 'analysis'

    // Downstream scientific thresholds (PS-DAS, SpliceNet, SpliceTrace, ORA)
    rmats_mode              = 'JCEC'
    event_set               = 'stable_significant'   // stable_significant (PS-DAS) | significant (Ordinary DAS)
    deg_fdr                 = 0.05
    deg_log2fc              = 1.0
    das_fdr                 = 0.05
    das_dpsi                = 0.10
    dtu_fdr                 = 0.05
    network_min_module_size = 20
    network_merge_cut_height = 0.25
    with_network_bootstrap  = false

    // Module toggles
    skip_fastqc             = false
    skip_trimming           = false
    skip_sequencing_qc      = false
    skip_genebody_coverage  = false
    skip_network            = false
    skip_splicetrace        = false
    skip_cross_paradigm     = false
    qc_results              = null

    // Upstream caller & alignment parameters
    read_length             = null
    allow_variable_read_length = true
    stranded_threshold      = 0.8
    unstranded_threshold    = 0.1
    strandedness_sample_size = 200000
    strandedness_mapq       = 30
    star_index              = null
    star_sjdb_overhang      = 99
    star_genome_sa_index_nbases = null
    salmon_archive          = 'https://github.com/COMBINE-lab/salmon/releases/download/v2.8.0/salmon-cli-x86_64-unknown-linux-gnu.tar.xz'
    salmon_archive_sha256   = '10a7f7994df7ef0592ac191cc79a1abd41316463000b307647a9dcab21e1efa6'
    salmon_seq_bias         = true
    salmon_gc_bias          = true
    alignment_quality       = 10
    aggregation             = true
    n_dexseq_plot           = 10
    min_samps_feature_expr  = 2
    min_samps_feature_prop  = 2
    min_samps_gene_expr     = 4
    min_feature_expr        = 10
    min_feature_prop        = 0.1
    min_gene_expr           = 10
    rmats_splice_diff_cutoff = 0.0001
    rmats_novel_splice_site = false
    rmats_min_intron_len    = 50
    rmats_max_exon_len      = 500
    suppa_per_local_event   = true
    suppa_per_isoform       = true
    generateevents_pool_genes = true
    generateevents_event_type = 'SE SS MX RI FL'
    generateevents_boundary = 'S'
    generateevents_threshold = 10
    generateevents_exon_length = 100
    psiperevent_total_filter = 0
    diffsplice_local_event  = true
    diffsplice_isoform      = true
    diffsplice_method       = 'empirical'
    diffsplice_area         = 1000
    diffsplice_lower_bound  = 0
    diffsplice_gene_correction = true
    diffsplice_alpha        = 0.05
    diffsplice_median       = false
    diffsplice_tpm_threshold = 0
    diffsplice_nan_threshold = 0
    clusterevents_local_event = false
    clusterevents_isoform   = false
    clusterevents_sigthreshold = null
    clusterevents_dpsithreshold = 0.05
    clusterevents_eps       = 0.05
    clusterevents_metric    = 'euclidean'
    clusterevents_separation = null
    clusterevents_min_pts   = 20
    clusterevents_method    = 'DBSCAN'

    // Container defaults
    katana_container        = 'ghcr.io/taratype0/katana-prism:1.0.3'
    dexseq_tools_container  = 'docker.io/j387735517/katana-dexseq-tools@sha256:20efe62e4679d6437c21938c624f7fdb18cc3c7fa8289456e1a73d9086b29717'

    // HPC / Slurm ceilings
    slurm_account           = null
    slurm_partition         = null
    project                 = null
    max_cpus                = null
    max_memory              = null
    max_time                = null
}

includeConfig 'conf/upstream_base.config'
includeConfig 'conf/upstream_modules.config'
includeConfig 'conf/upstream_task_resources.config'
includeConfig 'conf/standard_outputs.config'
includeConfig 'conf/portable_resources.config'

process {
    shell = ['/bin/bash', '-euo', 'pipefail']
    withName: '(SC_BUILD_SPLICE_MATRICES|SC_EXTRACT_MULTIPLEXED_BAM|SC_PREPARE_MARVEL_INPUTS|SC_ENUMERATE_TESTABLE_SUBTYPES|SC_SUBTYPE_DOWNSTREAM|SPLICEMANIFOLD|SPLICENET|SPLICETRACE|KATANA_CROSS_PARADIGM|KATANA_REPORT|SPLICEMANIFOLD_SC|SCSPLICENET|SCSPLICETRACE|KATANA_REPORT_SC|TARGET_REQUEST_INSPECT|TARGET_DETAIL|TARGET_AGGREGATE)' {
        container = { params.katana_container }
    }
}

cleanup = params.clean_work

def ceilings = [:]
if (params.max_cpus != null)   ceilings.cpus   = params.max_cpus
if (params.max_memory != null) ceilings.memory = params.max_memory
if (params.max_time != null)   ceilings.time   = params.max_time
if (ceilings) process.resourceLimits = ceilings

profiles {
    local { process.executor = 'local' }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
        apptainer.enabled = false
    }
    docker {
        docker.enabled = true
        docker.runOptions = '--user $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
    }
    slurm {
        process.executor = 'slurm'
    }
    pdc_dardel {
        includeConfig 'conf/pdc_kth.config'
    }
}
