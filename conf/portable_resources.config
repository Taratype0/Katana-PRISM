// Right-sized, HPC-aware resource allocations across Upstream, MultiQC & Katana Downstream modules.
// Retry escalates memory and wall-clock time on OOM/timeout while keeping serial tools at 1 CPU.
process {
    cpus = 1
    withLabel: process_single { cpus = 1; memory = { 6.GB * task.attempt }; time = { 4.h * task.attempt } }
    withLabel: process_low    { cpus = 2; memory = { 8.GB * task.attempt }; time = { 4.h * task.attempt } }
    withLabel: process_medium { cpus = 6; memory = { 24.GB * task.attempt }; time = { 8.h * task.attempt } }
    withLabel: process_high   { cpus = 12; memory = { 48.GB * task.attempt }; time = { 12.h * task.attempt } }

    // 1. Reference & validation tasks (lightweight single-pass streaming)
    withName: '(ADAPT_SUPPA_CONTRASTS|CONTRAST_TASK_SHEETS|ANALYSIS_TRANSCRIPTS|GFFREAD_TX2GENE|VALIDATE_INPUTS|VALIDATE_REFERENCE|PREPARE_REFERENCES|REFERENCE_FAIDX|STAGE_FASTQ)' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    // 2. Read QC & adapter trimming
    withName: '(FASTQC|BAM_FASTQC)' {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    withName: 'TRIMGALORE' {
        cpus   = 8
        memory = { 8.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }

    // 3. STAR index & 2-pass sorted alignment
    // Attempt 1 uses 54 GB (fits 64-GB servers AND Dardel shared queue: 64 * 888 MB = 55.5 GB),
    // escalating to 96 GB / 128 GB on retry for ultra-large genomes.
    withName: 'STAR_GENOMEGENERATE' {
        cpus   = 12
        memory = { task.attempt == 1 ? 54.GB : (task.attempt == 2 ? 96.GB : 128.GB) }
        time   = { 8.h * task.attempt }
    }
    withName: 'STAR_ALIGN' {
        cpus   = 12
        memory = { 48.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    // 4. BAM audit, conditional sorting, indexing, collation & upstream QC
    withName: 'CAPTURE_BAM_AUDIT' {
        cpus   = 2
        memory = { 6.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    withName: '(AUDIT_GENOME_BAM|SAMTOOLS_INDEX)' {
        cpus   = 2
        memory = { 2.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    withName: 'SAMTOOLS_BAM_STATS' {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
    withName: 'QUALIMAP_GENEBODY' {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    withName: 'SAMTOOLS_SORT' {
        cpus   = 6
        memory = { 24.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withName: 'COLLATE_GENOME_BAM' {
        cpus   = 4
        memory = { 12.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withName: 'SALMON_GENOME_PROJECTION' {
        cpus   = 6
        memory = { 12.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    // 5. Differential expression, exon usage (DEXSeq), DTU (DRIMSeq/stageR) & SUPPA
    withName: 'DEXSEQ_ANNOTATION' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    withName: 'DEXSEQ_COUNT' {
        cpus   = 1
        memory = { 6.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }
    withName: 'DEXSEQ_EXON' {
        cpus   = 6
        memory = { 16.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
    withName: 'DEXSEQ_DTU' {
        cpus   = 6
        memory = { 8.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }
    withName: '(KATANA_TXIMPORT|TXIMPORT|DRIMSEQ_FILTER|STAGER|KATANA_DESEQ2_CONTRAST|KATANA_NORMALIZE)' {
        cpus   = 1
        memory = { 6.GB * task.attempt }
        time   = { 3.h * task.attempt }
    }
    withName: '(DIFFSPLICE|GENERATE_EVENTS|PSIPEREVENT|PSIPERISOFORM|SPLIT_FILES|CLUSTEREVENTS)' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    // 6. rMATS prep (parallelized per sample across 4 CPUs!) & dynamic paired/unpaired post
    withName: 'RMATS_PREP_BAM' {
        cpus   = 4
        memory = { 6.GB * task.attempt }
        time   = { 3.h * task.attempt }
    }
    withName: 'RMATS_POST' {
        cpus = {
            def paired = rmats_paired_stats instanceof Map ? rmats_paired_stats[contrast] : rmats_paired_stats
            paired ? 8 : 4
        }
        memory = {
            def paired = rmats_paired_stats instanceof Map ? rmats_paired_stats[contrast] : rmats_paired_stats
            if (paired == null) throw new IllegalArgumentException("Missing paired-model declaration: ${contrast}")
            (paired ? 16.GB : 8.GB) * task.attempt
        }
        time = {
            def paired = rmats_paired_stats instanceof Map ? rmats_paired_stats[contrast] : rmats_paired_stats
            if (paired == null) throw new IllegalArgumentException("Missing paired-model declaration: ${contrast}")
            (paired ? 12.h : 3.h) * task.attempt
        }
    }

    // 7. MultiQC & Bundle Export
    withName: 'KATANA_MULTIQC' {
        cpus   = 1
        memory = { 6.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    withName: 'KATANA_EXPORT' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    // 8. Katana-PRISM 1.0.0 Modular Downstream Engines (Bulk & Single-Cell)
    withName: '(SPLICEMANIFOLD|SPLICEMANIFOLD_SC)' {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
        publishDir = [path: { "${params.outdir}/splicemanifold" }, mode: params.publish_dir_mode]
    }
    withName: 'SPLICENET' {
        cpus   = 4
        memory = { (params.with_network_bootstrap ? 32.GB : 16.GB) * task.attempt }
        time   = { (params.with_network_bootstrap ? 6.h : 2.h) * task.attempt }
        publishDir = [path: { "${params.outdir}/splicenet" }, mode: params.publish_dir_mode]
    }
    withName: 'SCSPLICENET' {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = { 2.h * task.attempt }
        publishDir = [path: { "${params.outdir}/scsplicenet" }, mode: params.publish_dir_mode]
    }
    withName: 'SPLICETRACE' {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = { 2.h * task.attempt }
        publishDir = [path: { "${params.outdir}/splicetrace" }, mode: params.publish_dir_mode]
    }
    withName: 'SCSPLICETRACE' {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = { 2.h * task.attempt }
        publishDir = [path: { "${params.outdir}/scsplicetrace" }, mode: params.publish_dir_mode]
    }
    withName: '(KATANA_REPORT|KATANA_REPORT_SC)' {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
        publishDir = [path: { params.outdir }, mode: params.publish_dir_mode]
    }
}
